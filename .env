# Copy to .env and edit
DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/coastguard
ADMIN_API_KEY=change-me-admin-key
# open_meteo = live data | sample = offline sample data (no internet)
WEATHER_PROVIDER=open_meteo
WEATHER_CACHE_MINUTES=15
WEATHER_TIMEOUT_SECONDS=10
# Extra origins allowed if the frontend runs on another port (VS Code Live Server = 5500)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# ML risk estimate: none | mock (sample result, clearly labelled) | http (call the model API below)
ML_PROVIDER=mock
ML_PREDICT_URL=
ML_TIMEOUT_SECONDS=5
